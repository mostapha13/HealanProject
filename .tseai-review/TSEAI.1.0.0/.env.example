# Never commit real secrets.
MSSQL_SA_PASSWORD=ChangeThis_Strong!Password123
RABBITMQ_DEFAULT_USER=tseai
RABBITMQ_DEFAULT_PASS=ChangeThis_Rabbit!Password123

# External market database: READ-ONLY credential only.
MARKET_DB_CONNECTION_STRING=Server=sql-ai-host;Database=MarketDb;User Id=tseai_readonly;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=True

# TSEAI application databases (same SQL container in local dev, separate DBs).
IDENTITY_DB_CONNECTION_STRING=Server=sqlserver,1433;Database=TSEAI_Identity;User Id=sa;Password=ChangeThis_Strong!Password123;TrustServerCertificate=True;Encrypt=False
APP_DB_CONNECTION_STRING=Server=sqlserver,1433;Database=TSEAI_App;User Id=sa;Password=ChangeThis_Strong!Password123;TrustServerCertificate=True;Encrypt=False

# Sprint 13 canonical SQL AI read model. Use a read-only login in Production.
SQL_AI_CONNECTION_STRING=Server=sql-ai-host,14330;Database=AI;User Id=tseai;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True
SQL_AI_CASHMARKET_MONEY_UNIT=Irr

# Development-only placeholders. Use secret management and strong independent values in production.
JWT_SIGNING_KEY=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_CHARACTERS________________________________
OTP_HASH_SECRET=CHANGE_ME_WITH_A_DIFFERENT_RANDOM_SECRET______________________________________

ASPNETCORE_ENVIRONMENT=Development
TZ=Asia/Tehran
SQL_AI_HOST_GATEWAY=host-gateway

# SMS provider used by TSEAI.Identity. Disable console fallback in production.
SMS_ENDPOINT=
SMS_API_KEY=
SMS_ALLOW_CONSOLE_FALLBACK=true
BOOTSTRAP_ADMIN_MOBILE=

# Local/external OpenAI-compatible semantic planners; Backend validation is always authoritative.
LLM_CHAT_PLANNER_ENABLED=true
LLM_FILTER_PLANNER_ENABLED=true
LLM_BASE_URL=http://local-llm:8080/v1
LLM_MODEL=qwen3.5-4b-fa
LLM_API_KEY=
LLM_MAX_CONCURRENCY=2
LLM_QUEUE_TIMEOUT_SECONDS=15
LLM_REQUEST_TIMEOUT_SECONDS=45

# Sprint 8 Alert Engine
ALERT_STREAM_READ_COUNT=20
ALERT_STATE_TTL_SECONDS=172800
ALERT_RULE_REFRESH_SECONDS=5
ALERT_OUTBOX_POLL_MS=500
ALERT_OUTBOX_BATCH_SIZE=50

ALERT_PENDING_CLAIM_IDLE_MS=30000
ALERT_OUTBOX_LEASE_SECONDS=120

# Sprint 9 Knowledge/RAG
# Set this to the read-only SQL AI / AI database connection (same landing DB used by canonical data).
KNOWLEDGE_CONNECTION_STRING=
KNOWLEDGE_POLL_SECONDS=120
KNOWLEDGE_BATCH_SIZE=250
KNOWLEDGE_ENABLE_PHASE1_AUTO_SOURCES=true
KNOWLEDGE_MAX_DOCUMENTS_PER_SOURCE_RUN=100000
KNOWLEDGE_WATERMARK_OVERLAP_MINUTES=5
# Local semantic retrieval through the Compose llama.cpp embedding service.
EMBEDDING_BASE_URL=http://local-embedding:8080/v1
EMBEDDING_MODEL=qwen3-embedding-0.6b
EMBEDDING_DIMENSION=1024
EMBEDDING_API_KEY=
QDRANT_KNOWLEDGE_COLLECTION=tseai_knowledge_v1

# MCP is disabled by default. Explicit server/tool allowlists are required.
Mcp__Enabled=false
# Sprint 16 — Data Quality & Freshness
DATA_QUALITY_MARKET_START_LOCAL=08:30
DATA_QUALITY_MARKET_END_LOCAL=13:30
DATA_QUALITY_MARKET_LIVE_MAX_AGE_SECONDS=30
DATA_QUALITY_OFF_HOURS_MAX_AGE_HOURS=24
DATA_QUALITY_WEEKEND_MAX_AGE_HOURS=96
DATA_QUALITY_CANONICAL_CURRENT_MAX_AGE_HOURS=24
DATA_QUALITY_CANONICAL_VERSIONED_MAX_AGE_DAYS=14
DATA_QUALITY_CANONICAL_REFERENCE_MAX_AGE_DAYS=30
