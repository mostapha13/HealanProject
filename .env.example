# کپی کنید به .env در ریشه پروژه و مقادیر را ویرایش کنید:
#   cp .env.example .env
#
# پس از تغییر رمز SQL، همان رمز را در
# docker/config/*/appsettings.Production.json هم به‌روز کنید.

MSSQL_SA_PASSWORD=YourStrong!Passw0rd

# NegareshAI standalone Docker stack
NEGARESHAI_SQL_PASSWORD=ReplaceWithAStrongLocalPassword
NEGARESHAI_IDENTITY_URL=http://host.docker.internal:5005
NEGARESHAI_FILEMANAGER_URL=http://host.docker.internal:6823/
NEGARESHAI_WEB_ORIGIN=http://localhost:3000
NEGARESHAI_DEVELOPMENT_ORGANIZATION_ID=11111111-1111-1111-1111-111111111111
NEGARESHAI_PUBLIC_API_URL=http://localhost:6129
